@startuml Архитектура_АгроТех_C2_Решение_А

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Контейнерная диаграмма (C2): Вариант А

Person(директор, "Зоотехник / Директор")
Person(оператор, "Диспетчер")
Person(дежурный, "Дежурный на ферме")

System_Boundary(agro_platform, "Платформа 'АгроПром Х'") {
    Container(веб_портал, "Веб-портал", "React", "Панель администрирования, аналитика и дашборды")
    Container(мобильное_приложение, "Мобильное приложение", "Flutter", "Оперативные алерты, мобильное рабочее место")
    System_Ext(kafka, "Apache Kafka", "Центральная шина платформы")
    System_Ext(erp, "ERP (1С:Агро)", "Учет поголовья, кормов и финансов")
}

System_Boundary(livestock_system_boundary, "Система мониторинга животноводства (Cloud/Center)") {
    
    Container(api_gateway, "API Gateway", "Envoy / Traefik", "Единая точка входа. Аутентификация, маршрутизация, Rate Limiting")
    
    Container(core_service, "Центральный сервис (Core API)", "Go / Python", "Бизнес-логика, управление расписаниями кормления, оркестрация инцидентов. Предоставляет REST/gRPC API")
    
    Container(notification_service, "Сервис уведомлений", "Node.js / Go", "Управляет Push-нотификациями и WebSockets соединениями для UI")
    
    Container(integration_service, "Сервис интеграции (Bridge)", "Python", "Асинхронный адаптер для обмена данными с 1С и внешней Kafka")
    
    ContainerDb(central_db, "Центральная БД", "PostgreSQL (TimescaleDB)", "Хранение долгосрочной телеметрии, профилей животных, настроек и логов")
}

System_Boundary(farm_edge, "Контур Фермы (Edge)") {
    
    Container(iot_smart_agent, "Умный Edge-Агент", "C++ / Go / Python", "Легковесный демон на ферме. Буферизирует видеопоток, локально гоняет ONNX-модели. Отправляет агрегированные данные по gRPC в облако. При потере связи удерживает базовую автоматику")
    
    Container(local_mqtt, "Локальный MQTT Брокер", "Mosquitto", "Легковесная шина только для сбора метрик с датчиков и отправки команд на кормушки")
}

System_Boundary(farm_hardware, "Оборудование Фермы") {
    System_Ext(cameras, "Камеры", "RTSP")
    System_Ext(feeders, "Кормушки/Поилки", "Modbus / MQTT")
    System_Ext(siren, "Локальная сирена/лампа", "GPIO / Реле")
}

Rel(директор, веб_портал, "Использует", "HTTPS")
Rel(оператор, веб_портал, "Мониторит", "HTTPS")
Rel(оператор, мобильное_приложение, "Получает пуши", "Firebase/APNS")

Rel(веб_портал, api_gateway, "Запросы метрик и дашбордов", "HTTPS / REST")
Rel(мобильное_приложение, api_gateway, "Управление и просмотр алертов", "HTTPS / REST")
Rel(api_gateway, notification_service, "Подключение для real-time обновлений", "WebSockets")

Rel(api_gateway, core_service, "Маршрутизация запросов", "gRPC")
Rel(core_service, central_db, "Чтение/Запись данных", "SQL")
Rel(core_service, notification_service, "Триггер алертов для отправки пользователям", "внутренний REST")

Rel(core_service, integration_service, "Передача данных для внешних систем", "gRPC")
Rel(integration_service, kafka, "Экспорт событий", "Kafka Protocol")
Rel(integration_service, erp, "Синхронизация данных (Поголовье/Прогнозы)", "REST API (1С)")

Rel(iot_smart_agent, api_gateway, "Стриминг телеметрии и фактов аномалий", "gRPC / HTTP/2")
Rel(core_service, iot_smart_agent, "Синхронная отправка управляющих команд", "gRPC (Обратный канал / Long-Lived Stream)")

Rel(cameras, iot_smart_agent, "Передача видеопотока", "RTSP")
Rel(feeders, local_mqtt, "Публикация телеметрии", "MQTT")
Rel(local_mqtt, iot_smart_agent, "Сбор данных с датчиков", "MQTT")
Rel(iot_smart_agent, local_mqtt, "Публикация команд управления", "MQTT")
Rel(local_mqtt, feeders, "Исполнение команд дозирования", "MQTT / Modbus")
Rel(iot_smart_agent, siren, "Прямое включение при критическом оффлайн-сбое", "GPIO / Реле")
Rel(iot_smart_agent, дежурный, "Свето-звуковое оповещение на месте", "Физический сигнал")

@enduml