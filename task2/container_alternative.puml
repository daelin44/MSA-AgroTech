@startuml Архитектура_АгроТех_C2_Решение_А

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Контейнерная диаграмма (C2): Вариант Б

Person(дежурный, "Дежурный на ферме")

System_Ext(kafka, "Apache Kafka", "Центральная шина платформы 'АгроПром Х'")
System_Ext(мобильное_приложение, "Мобильное приложение", "Flutter")

System_Boundary(livestock_system_boundary, "Система мониторинга животноводства (Edge Cluster)") {
    
    Container(local_broker, "Локальный брокер сообщений", "RabbitMQ", "Обеспечивает внутренний асинхронный pub/sub и интеграцию с IoT по MQTT")
    
    Container(video_analyzer, "Модуль видеоаналитики", "Python (ONNX Runtime / FastStream)", "Захват RTSP, инференс ИИ моделей, генерация сырых событий аномалий")
    
    Container(livestock_core, "Ядро мониторинга (Core Service)", "Python (FastAPI / SQLAlchemy)", "Бизнес-логика, ведение локального учета, агрегация метрик, оркестрация Ack Loop")
    
    ContainerDb(local_db, "Локальная БД", "PostgreSQL", "Хранение временного состояния, буферизация алертов и метрик для синхронизации")
    
    Container(iot_gateway, "IoT Шлюз автоматизации", "Python / Go", "Драйверы оборудования. Двунаправленный обмен: команды и сбор телеметрии (Modbus TCP / MQTT)")
    
    Container(platform_bridge, "Мост синхронизации (Bridge)", "Python (FastStream)", "Асинхронный коннектор между локальным RabbitMQ и центральной Kafka. Управляет оффлайн-буфером")
}

System_Boundary(farm_hardware, "Оборудование Фермы") {
    System_Ext(cameras, "Камеры", "RTSP")
    System_Ext(feeders, "Кормушки/Поилки", "Modbus / MQTT")
    System_Ext(siren, "Локальная сирена/лампа", "GPIO / Реле")
}

Rel(дежурный, мобильное_приложение, "Получает уведомления")
Rel(kafka, мобильное_приложение, "Push нотификации")

Rel(cameras, video_analyzer, "Передача видеопотока", "RTSP")
Rel(video_analyzer, local_broker, "Публикация событий детекции (raw_event)", "AMQP")

Rel(feeders, iot_gateway, "Отправка телеметрии, веса животных и расхода корма/воды", "MQTT / Modbus TCP")
Rel(iot_gateway, local_broker, "Публикация сырых метрик оборудования (hardware_metrics)", "AMQP")

Rel(local_broker, livestock_core, "Подписка на события детекции и метрики оборудования", "AMQP")
Rel(livestock_core, local_db, "Чтение/Запись состояния, логов кормления и алертов", "SQL / SQLAlchemy")

Rel(livestock_core, local_broker, "Команды кормления / Команды алертинга", "AMQP")
Rel(local_broker, iot_gateway, "Маршрутизация команд управления", "AMQP")
Rel(iot_gateway, feeders, "Управляющие команды дозирования", "Modbus TCP / MQTT")
Rel(livestock_core, siren, "Прямое физическое переключение при таймауте ACK", "GPIO / dry contact")

Rel(local_broker, platform_bridge, "Обмен метриками, телеметрией устройств и алертами", "AMQP")
Rel(platform_bridge, kafka, "Публикация алертов (PENDING), метрик здоровья и телеметрии оборудования", "Kafka Protocol (TLS)")
Rel(kafka, platform_bridge, "Чтение входящих ACK-сообщений", "Kafka Protocol")
Rel(platform_bridge, local_broker, "Проброс ACK в Core Service", "AMQP")

@enduml