@startuml Архитектура_АгроТех_C4_Хореография_Generic_Код

title Диаграмма кода (C4): Вариант Б — Компоненты IoT Шлюза (Общие типы)

package "IoT Gateway Internal Architecture" {

    class IncidentEventListener {
        - timeoutManager: TimeoutManager
        - commandPublisher: CommandPublisher
        + onIncidentDetected(event: IncidentEvent): void
        + onCentralAckReceived(event: AckEvent): void
    }

    class TimeoutManager {
        - active_timers: Map<string, Timer>
        - gpio: GPIODriver
        + start_ack_countdown(incident_id: string, delay_seconds: int): void
        + cancel_countdown(incident_id: string): void
        - fire_local_siren(): void
    }

    class CommandPublisher {
        - mqttClient: MqttClient
        + publishFeederCommand(feederId: string, command: string, payload: string): boolean
    }

    class TelemetryInboundBridge {
        - mqttClient: MqttClient
        - amqpClient: AmqpClient
        + startTelemetryLoop(): void
        - handleRawHardwareTelemetry(topic: string, payload: bytes): void
    }

    class GPIODriver {
        - pin: int
        + write_high(): void
        + write_low(): void
    }

    note right of TimeoutManager::start_ack_countdown
        Локальный guard-таймер:
        Если за 5 секунд от IncidentEventListener 
        не вызовется cancel_countdown(), 
        автономно сработает fire_local_siren()
    end note

    IncidentEventListener --> TimeoutManager : управляет жизненным циклом таймеров
    IncidentEventListener --> CommandPublisher : транслирует команды автоматизации
    TelemetryInboundBridge --> CommandPublisher : использует общие сетевые ресурсы
    TimeoutManager --> GPIODriver : физически включает сирену в обход сети
}

@enduml