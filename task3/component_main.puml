@startuml Архитектура_АгроТех_C3_Хореография

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Диаграмма компонентов (C3): Вариант А (Хореография)

Container(local_broker, "Локальный брокер", "RabbitMQ", "Событийная шина (AMQP Topic Exchange)")
Container(local_mqtt, "Локальный MQTT брокер", "Mosquitto", "Технологическая шина для датчиков и исполнительных механизмов")
ContainerDb(local_db, "Локальная БД", "PostgreSQL", "Реляционная база (Логи + Конфигурации)")
Person(дежурный, "Дежурный на ферме")
System_Ext(siren, "Сирена / Лампа", "GPIO / Реле")
System_Ext(feeders, "Кормушки/Поилки", "Modbus / MQTT")

Container_Boundary(video_boundary, "Модуль видеоаналитики (Python)") {
    Component(video_capture, "Video Capture", "OpenCV / RTSP", "Захват потоков с камер")
    Component(inference_engine, "Inference Engine", "ONNX Runtime", "ИИ-аналитика поведения животных")
    Component(event_emitter, "Event Breeder", "FastStream", "Публикует 'incident.detected' и 'telemetry.video'")
    
    Rel(video_capture, inference_engine, "Кадры")
    Rel(inference_engine, event_emitter, "Результат")
}

Container_Boundary(gateway_boundary, "Реактивный IoT Шлюз (Go)") {
    Component(amqp_subscriber, "AMQP Subscriber", "amqp091", "Слушает 'incident.detected' и 'central.ack'")
    Component(timeout_manager, "Timeout Manager", "In-Memory State", "Контролирует 5-секундный SLA для сирены")
    Component(gpio_driver, "GPIO Driver", "Native Sysfs", "Прямое физическое включение сирены")
    Component(mqtt_publisher, "MQTT Command Publisher", "paho.mqtt", "Публикует команды автоматизации в Mosquitto")
    Component(mqtt_subscriber, "MQTT Telemetry Subscriber", "paho.mqtt", "Собирает сырую телеметрию с Mosquitto, агрегирует и шлет в RabbitMQ")
    
    Rel(amqp_subscriber, timeout_manager, "События инцидентов/ACK")
    Rel(timeout_manager, gpio_driver, "Триггерит при таймауте")
    Rel(amqp_subscriber, mqtt_publisher, "Команды автоматизации")
}

Container_Boundary(ui_boundary, "Локальный Веб-портал (Nginx + FastAPI)") {
    Component(static_server, "Web Server", "Nginx", "Раздает SPA-фронтенд для дежурного")
    Component(ui_api, "UI API Gateway", "FastAPI", "Проксирует запросы, проверяет локальные права доступа")
    
    Rel(static_server, ui_api, "XHR/Fetch запросы")
}

Container_Boundary(logger_boundary, "Сервис истории и конфигурации (Python)") {
    Component(wildcard_listener, "Wildcard Listener", "FastStream", "Подписан на все события (*.*) для аудита")
    Component(event_marshaller, "Event Marshaller", "Pydantic", "Валидирует и сериализует логи")
    Component(config_manager, "Config Manager", "FastAPI Сервис", "Предоставляет REST API для чтения настроек датчиков и порогов ИИ")
    Component(db_writer, "DB Access Layer", "SQLAlchemy Async", "Асинхронная запись логов и чтение конфигураций")
    
    Rel(wildcard_listener, event_marshaller, "Сырой JSON")
    Rel(event_marshaller, db_writer, "Пакетный Append")
    Rel(config_manager, db_writer, "CRUD операции")
}

' Связи пользователей
Rel(дежурный, static_server, "Взаимодействие", "HTTP / Браузер")
Rel(ui_api, config_manager, "Запрос логов / Обновление настроек устройств", "REST / HTTP")

' Связи с брокерами и железом
Rel(event_emitter, local_broker, "Публикует аномалии", "AMQP (RK: incident.detected)")
Rel(mqtt_subscriber, local_broker, "Публикует telemetry.received", "AMQP (RK: telemetry.received)")
Rel(local_broker, amqp_subscriber, "Доставляет события", "AMQP")
Rel(local_broker, wildcard_listener, "Доставляет все сообщения (*.*)", "AMQP")

Rel(feeders, local_mqtt, "Сырые метрики расхода", "MQTT (telemetry/feeders)")
Rel(local_mqtt, mqtt_subscriber, "Подписка на метрики", "MQTT")
Rel(mqtt_publisher, local_mqtt, "Публикация команд дозирования", "MQTT (commands/feeders)")
Rel(local_mqtt, feeders, "Доставка команд", "MQTT / Modbus")

Rel(gpio_driver, siren, "Замыкает реле", "GPIO")
Rel(db_writer, local_db, "Чтение/Запись", "SQL")

@enduml