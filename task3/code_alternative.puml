@startuml Архитектура_АгроTech_C4_API_First_Generic_Код

title Диаграмма кода (C4): Вариант А — Компоненты Умного Edge-Агента (Общие типы)

package "Smart Edge Agent Architecture" {

    enum ConnectionState {
        ONLINE
        OFFLINE
        SYNCHRONIZING
    }

    class CloudStreamClient {
        - connectionState: ConnectionState
        - fifoBuffer: FifoBuffer
        - fallbackEngine: FallbackEngine
        + connectToCloud(): void
        + sendIncident(event: IncidentData): boolean
        + sendTelemetry(metrics: TelemetryBatch): boolean
        - onCloudCommandReceived(command: CloudCommand): void
        - onNetworkReconnected(): void
    }

    class FifoBuffer {
        - storagePath: string
        - maxDiskSizeBytes: long
        + push(payload: bytes, priority: int): void
        + popBatch(size: int): List<bytes>
        + ackBatch(batchIds: List<string>): void
        - clearOldestTelemetry(): void
    }

    class VideoStreamProcessor {
        - rtspSource: string
        - neuralNetwork: NeuralEngine
        - streamClient: CloudStreamClient
        - fifoBuffer: FifoBuffer
        + startAnalysisLoop(): void
        - processFrame(frame: bytes): void
    }

    class FallbackEngine {
        - hardwareClient: MqttClient
        - isAutonomousModeActive: boolean
        + activateAutonomousMode(): void
        + deactivateAutonomousMode(): void
        - runDefaultFeedingSchedule(): void
    }

    class HardwareBridge {
        - hardwareClient: MqttClient
        - streamClient: CloudStreamClient
        + forwardLocalMetricsToAgent(): void
        + sendCommandToDevice(targetId: string, cmd: bytes): void
    }

    note top of FifoBuffer
        Компонент Offline-first отказоустойчивости.
        Если ConnectionState == OFFLINE, модули
        видеоаналитики и железа пишут данные сюда.
        При лимите диска срабатывает clearOldestTelemetry().
    end note

    CloudStreamClient --> ConnectionState : отслеживает состояние аплинка
    CloudStreamClient --> FifoBuffer : вычитывает накопленные данные при восстановлении сети
    CloudStreamClient --> FallbackEngine : переключает режимы управления фермой
    VideoStreamProcessor --> CloudStreamClient : шлет аномалии напрямую в сеть
    VideoStreamProcessor --> FifoBuffer : сбрасывает аномалии на диск при аварии
    HardwareBridge --> CloudStreamClient : передает метрики устройств
    FallbackEngine --> HardwareBridge : генерирует резервные локальные команды
}

@enduml