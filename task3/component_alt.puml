@startuml Архитектура_АгроТех_C3_API_First_gRPC

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Диаграмма компонентов (C3): Вариант А - API-First (gRPC + Облако)

Container(api_gateway, "API Gateway", "Envoy / Traefik", "Единая точка входа в Облако")
Container(local_mqtt, "Локальный MQTT брокер", "Mosquitto", "Шина датчиков на ферме")
System_Ext(siren, "Сирена", "GPIO")
System_Ext(cameras, "Камеры", "RTSP")

Container_Boundary(agent_boundary, "Умный Edge-Агент (Go / C++)") {
    Component(edge_capture, "Video Streamer", "OpenCV / ONNX", "Локальный захват RTSP и инференс моделей")
    Component(mqtt_bridge, "MQTT Client Loop", "paho.mqtt", "Сбор локальных метрик с Mosquitto и отправка команд назад")
    Component(grpc_client, "gRPC Stream Client", "grpc-go", "Поддерживает Long-Lived Bidirectional Stream с Облаком")
    Component(fifo_manager, "Offline FIFO Buffer", "SQLite / Local Files", "Буферизирует телеметрию на диск при обрыве сети. Вытесняет старое по лимиту")
    Component(fallback_engine, "Fallback Logic", "In-Memory Cron", "Автономно управляет кормушками по жесткому расписанию, если Облако недоступно")
    
    Rel(edge_capture, grpc_client, "Отправка incident.detected (при наличии сети)")
    Rel(edge_capture, fifo_manager, "Запись инцидента на диск (если оффлайн)")
    Rel(mqtt_bridge, grpc_client, "Стриминг телеметрии")
    Rel(grpc_client, fifo_manager, "Репликация накопленного буфера при восстановлении сети")
    Rel(grpc_client, mqtt_bridge, "Транзит входящих команд из Облака")
    Rel(fifo_manager, fallback_engine, "Сигнал о переходе в автономный режим")
    Rel(fallback_engine, mqtt_bridge, "Резервные локальные команды")
}

Container_Boundary(core_boundary, "Центральный сервис Облака (Core API на Go)") {
    Component(grpc_server, "gRPC Server Handler", "grpc-go", "Принимает соединения от сотен Edge-агентов с ферм")
    Component(incident_orchestrator, "Incident Orchestrator", "Go Domain Logic", "Проверяет правила, обогащает данные, принимает решение о включении сирен")
    Component(telemetry_processor, "Telemetry Processor", "Go Channels", "Агрегирует временные ряды для TimescaleDB")
    Component(config_service, "Config Registry", "Go REST/gRPC", "Хранит и распространяет прошивки, настройки устройств и веса моделей")
    Component(db_client, "Database Client", "pgx / SQLx", "Высокопроизводительное подключение к СУБД")
    
    Rel(grpc_server, incident_orchestrator, "Поток инцидентов ферм")
    Rel(grpc_server, telemetry_processor, "Поток метрик")
    Rel(incident_orchestrator, db_client, "Мутация состояния инцидента")
    Rel(telemetry_processor, db_client, "Пакетный Bulk Insert метрик")
    Rel(config_service, db_client, "Чтение настроек")
    Rel(incident_orchestrator, grpc_server, "Отправка команды 'Включить сирену' в обратный gRPC-канал")
}

ContainerDb(central_db, "Центральная БД", "PostgreSQL (TimescaleDB)", "Глобальное хранилище всей системы")

Rel(cameras, edge_capture, "Видеопоток", "RTSP")
Rel(mqtt_bridge, local_mqtt, "Обмен данными с железом", "MQTT")
Rel(edge_capture, siren, "Аварийный триггер", "GPIO")

Rel(grpc_client, api_gateway, "Установление сессии и стриминг", "gRPC / HTTP/2 (TLS)")
Rel(api_gateway, grpc_server, "Маршрутизация gRPC трафика", "gRPC")

Rel(db_client, central_db, "Пул соединений", "SQL")

@enduml